# Public site URL (canonical links, sitemap, Open Graph). Set once a domain is chosen.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Analytics: PostHog free tier. Leave empty to disable (events are logged to the console in development).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feedback: the ID from your Formspree form URL, https://formspree.io/f/<id>. Leave empty to disable submitting.
NEXT_PUBLIC_FORMSPREE_ID=
